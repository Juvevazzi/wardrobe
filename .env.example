OPENAI_API_KEY=
# Point at a local or alternative OpenAI-compatible endpoint if needed.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Override the model used for a specific stage; falls back to OPENAI_IMAGE_MODEL.
OPENAI_GARMENT_MODEL=
OPENAI_MODELED_MODEL=
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
# Where jobs, the imported library, and imported assets are stored.
WARDROBE_DATA_DIR=data
# Comma-separated extra hostnames the dev server should accept (e.g. behind a reverse proxy).
WARDROBE_ALLOWED_HOSTS=

# Required once the app is reachable from beyond localhost (see Phase 1). Unset = no auth.
# Set this to a long random string and use it to log in from the web UI.
WARDROBE_ACCESS_TOKEN=
# Caps how many OpenAI image/vision calls the app will make per UTC day. Unset = unlimited.
WARDROBE_DAILY_JOB_LIMIT=
# How many garment/modeled generations run at once. Defaults to 3.
WARDROBE_GENERATION_CONCURRENCY=

# `npm start` only (the production server). Defaults shown; HOST=0.0.0.0 is set for you in Docker.
PORT=4173
HOST=127.0.0.1
